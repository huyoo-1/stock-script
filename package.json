  },
  "dependencies": {
    "axios": "^1.7.0",
    "@larksuiteoapi/node-sdk": "^1.71.0"
  },
  "optionalDependencies": {
    "https-proxy-agent": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
